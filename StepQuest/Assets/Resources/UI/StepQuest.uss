/* StepQuest UI — dark lacquered panels with thin gold trim, parchment text.
   Reference resolution 1080×1920 (scaled to screen width). */

:root {
    --gold: #d8b765;
    --gold-dim: #8c6b3a;
    --ink: #0b1020;
    --panel: rgba(12, 17, 33, 0.9);
    --panel-2: rgba(22, 30, 54, 0.92);
    --text: #f3e9d2;
    --muted: #b9ab8a;
    --hp: #6fd36f;
    --mp: #5aa8ff;
    --danger: #e0574a;
    --good: #7be08a;
    font-size: 32px;
    color: var(--text);
}

.root { flex-grow: 1; }
.safe { flex-grow: 1; }
.content { flex-grow: 1; padding: 0 24px; }
.scroll { flex-grow: 1; }
.spacer { flex-grow: 1; }
.row { flex-direction: row; align-items: center; }
.col { flex-direction: column; }
.wrap { flex-wrap: wrap; }
.center { align-items: center; justify-content: center; }
.hidden { display: none; }

/* ───────── Panels ───────── */
.panel {
    background-color: var(--panel);
    border-width: 2px;
    border-color: var(--gold-dim);
    border-radius: 10px;
    padding: 20px 24px;
    margin-bottom: 18px;
}
.panel.inset { background-color: var(--panel-2); }
.panel.glow { border-color: var(--gold); }
.card {
    background-color: var(--panel-2);
    border-width: 1px;
    border-color: rgba(216, 183, 101, 0.4);
    border-radius: 8px;
    padding: 16px 18px;
    margin-bottom: 12px;
}
.card.locked { opacity: 0.55; }
.card.done { border-color: var(--good); }
.divider { height: 2px; background-color: rgba(216, 183, 101, 0.35); margin: 12px 0; }

/* ───────── Text ───────── */
.title { font-size: 46px; color: var(--gold); -unity-font-style: bold; margin-bottom: 8px; }
.h2 { font-size: 36px; color: var(--gold); -unity-font-style: bold; margin-bottom: 6px; }
.h3 { font-size: 32px; -unity-font-style: bold; }
.small { font-size: 26px; }
.tiny { font-size: 22px; }
.muted { color: var(--muted); }
.gold { color: var(--gold); }
.good { color: var(--good); }
.bad { color: var(--danger); }
.big-number { font-size: 64px; -unity-font-style: bold; color: var(--gold); }
.right { -unity-text-align: middle-right; }
.wrap-text { white-space: normal; }

/* ───────── Buttons ───────── */
.btn {
    background-color: #2b2416;
    border-width: 2px;
    border-color: var(--gold);
    border-radius: 8px;
    color: var(--text);
    font-size: 32px;
    -unity-font-style: bold;
    padding: 14px 22px;
    margin: 6px;
    transition-duration: 0.12s;
    transition-property: scale, background-color;
}
.btn:hover { background-color: #3d3220; }
.btn:active { scale: 0.96 0.96; background-color: #4d3f24; }
.btn:disabled { opacity: 0.4; }
.btn.primary { background-color: #6b4f1d; color: #fff3cf; }
.btn.danger { background-color: #4a1a16; border-color: var(--danger); }
.btn.ghost { background-color: rgba(0, 0, 0, 0); border-color: var(--gold-dim); }
.btn.small { font-size: 26px; padding: 8px 14px; }
.btn.wide { flex-grow: 1; }
.btn.cmd { flex-grow: 1; flex-basis: 30%; height: 96px; font-size: 34px; }
.btn.target { flex-grow: 1; flex-basis: 45%; }
.btn.selected { border-color: #fff3cf; background-color: #5a4320; }

/* ───────── Top bar ───────── */
.topbar {
    flex-direction: row;
    align-items: center;
    background-color: rgba(8, 11, 22, 0.85);
    border-bottom-width: 2px;
    border-color: var(--gold-dim);
    padding: 14px 20px;
}
.stat-chip { flex-direction: column; align-items: center; flex-grow: 1; }
.stat-chip .value { font-size: 38px; -unity-font-style: bold; }
.stat-chip .label { font-size: 20px; color: var(--muted); letter-spacing: 2px; }
.stat-chip.actions .value { color: var(--gold); font-size: 48px; }
.icon-btn { width: 84px; height: 84px; font-size: 40px; padding: 0; margin: 0 0 0 8px; }

/* ───────── Nav bar ───────── */
.navbar {
    flex-direction: row;
    background-color: rgba(8, 11, 22, 0.94);
    border-top-width: 2px;
    border-color: var(--gold-dim);
    padding: 8px 6px 14px 6px;
}
.nav-btn {
    flex-grow: 1;
    flex-basis: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--muted);
    font-size: 24px;
    padding: 12px 0;
    margin: 0;
    flex-direction: column;
}
.nav-btn .glyph { font-size: 40px; -unity-text-align: middle-center; }
.nav-btn .label { font-size: 22px; -unity-text-align: middle-center; }
.nav-btn.active { color: var(--gold); }
.nav-btn.active .glyph { scale: 1.12 1.12; }
.badge {
    position: absolute; top: 4px; right: 22%;
    background-color: var(--danger); color: white; font-size: 20px;
    border-radius: 14px; padding: 0 8px; -unity-font-style: bold;
}

/* ───────── Bars ───────── */
.bar { height: 18px; background-color: rgba(0, 0, 0, 0.55); border-radius: 9px; overflow: hidden; border-width: 1px; border-color: rgba(255,255,255,0.12); }
.bar.thick { height: 28px; border-radius: 14px; }
.bar.thin { height: 10px; border-radius: 5px; }
.bar-fill { height: 100%; background-color: var(--gold); border-radius: 9px; transition-duration: 0.4s; transition-property: width; }
.bar-fill.hp { background-color: var(--hp); }
.bar-fill.hp.low { background-color: var(--danger); }
.bar-fill.mp { background-color: var(--mp); }
.bar-fill.exp { background-color: #c79bff; }
.bar-fill.good { background-color: var(--good); }

/* ───────── Battle ───────── */
.battle-hud { flex-grow: 1; justify-content: flex-end; }
.battle-top { flex-direction: row; justify-content: space-between; padding: 12px 20px; }
.turn-strip { flex-direction: row; align-items: center; padding: 8px 12px; background-color: rgba(8, 11, 22, 0.7); border-radius: 10px; margin: 0 20px 10px 20px; }
.turn-chip { width: 64px; height: 64px; margin-right: 6px; border-radius: 8px; border-width: 2px; border-color: rgba(255,255,255,0.15); background-color: rgba(0,0,0,0.4); -unity-background-scale-mode: scale-to-fit; }
.turn-chip.hero { border-color: rgba(120, 180, 255, 0.6); }
.turn-chip.enemy { border-color: rgba(255, 110, 90, 0.6); }
.turn-chip.current { border-color: var(--gold); width: 80px; height: 80px; }
.hero-row { flex-direction: row; align-items: center; padding: 8px 12px; border-radius: 8px; margin-bottom: 4px; }
.hero-row.active { background-color: rgba(216, 183, 101, 0.18); border-width: 1px; border-color: var(--gold); }
.hero-row.fallen { opacity: 0.45; }
.hero-row .name { width: 230px; font-size: 28px; }
.hero-row .bars { flex-grow: 1; }
.hero-row .nums { width: 150px; font-size: 22px; -unity-text-align: middle-right; color: var(--muted); }
.enemy-tag {
    position: absolute;
    background-color: rgba(8, 11, 22, 0.8);
    border-width: 1px; border-color: rgba(255,120,100,0.6); border-radius: 8px;
    padding: 4px 10px;
    translate: -50% -100%;
    min-width: 140px;
}
.enemy-tag .name { font-size: 22px; -unity-text-align: middle-center; }
.shield-row { flex-direction: row; justify-content: center; }
.shield-pip { width: 18px; height: 22px; margin: 1px; background-color: #8fb4ff; border-radius: 3px; }
.shield-pip.empty { background-color: rgba(255,255,255,0.15); }
.weak-row { flex-direction: row; justify-content: center; }
.weak-icon { font-size: 20px; margin: 0 2px; color: var(--gold); }
.broken-label { font-size: 22px; color: #ffd86b; -unity-font-style: bold; -unity-text-align: middle-center; }

.floater {
    position: absolute;
    font-size: 54px;
    -unity-font-style: bold;
    translate: -50% -50%;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgba(0,0,0,0.85);
    transition-duration: 0.9s;
    transition-property: translate, opacity;
}
.floater.heal { color: var(--good); }
.floater.crit { color: #ffd86b; font-size: 66px; }
.floater.weak { color: #ffb36b; }
.floater.break { color: #ffd86b; font-size: 76px; }
.floater.rise { translate: -50% -180%; opacity: 0; }

.banner {
    background-color: rgba(8, 11, 22, 0.9);
    border-top-width: 2px; border-bottom-width: 2px; border-color: var(--gold);
    padding: 18px 24px;
    margin: 10px 0;
}
.log-line { font-size: 24px; color: var(--muted); }

/* ───────── Overlay ───────── */
.overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.toast-stack { position: absolute; top: 160px; left: 40px; right: 40px; align-items: center; }
.toast {
    background-color: rgba(20, 16, 8, 0.95);
    border-width: 2px; border-color: var(--gold); border-radius: 12px;
    padding: 18px 24px; margin-bottom: 12px; min-width: 70%;
    transition-duration: 0.35s; transition-property: opacity, translate;
}
.toast.out { opacity: 0; translate: 0 -30px; }
.modal-back { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(0,0,0,0.6); justify-content: center; padding: 60px; }
.modal { background-color: var(--panel); border-width: 2px; border-color: var(--gold); border-radius: 14px; padding: 30px; max-height: 85%; }

/* ───────── Misc ───────── */
.portrait { width: 128px; height: 160px; -unity-background-scale-mode: scale-to-fit; margin-right: 18px; }
.portrait.small { width: 72px; height: 90px; margin-right: 12px; }
.chip { background-color: rgba(216, 183, 101, 0.16); border-radius: 16px; padding: 4px 14px; margin: 4px; font-size: 24px; }
.chip.on { background-color: rgba(123, 224, 138, 0.25); }
.stat-grid { flex-direction: row; flex-wrap: wrap; }
.stat-cell { width: 33%; flex-direction: row; justify-content: space-between; padding: 4px 12px 4px 0; }
.tab-row { flex-direction: row; margin-bottom: 12px; }
.tab { flex-grow: 1; }
.rarity-Common { color: var(--text); }
.rarity-Uncommon { color: #7be08a; }
.rarity-Rare { color: #6fb4ff; }
.rarity-Epic { color: #c79bff; }
.rarity-Legendary { color: #ffb347; }
.moon { width: 140px; height: 140px; border-radius: 70px; background-color: #e8e4d8; border-width: 4px; border-color: var(--gold-dim); margin-right: 24px; overflow: hidden; justify-content: flex-end; }
.moon-fill { background-color: #ffd86b; width: 100%; }
.slider-row { margin: 12px 0; }
.unity-base-slider__dragger { background-color: var(--gold); border-color: var(--gold); width: 36px; height: 36px; margin-top: -14px; border-radius: 18px; }
.unity-base-slider__tracker { background-color: rgba(255,255,255,0.2); height: 8px; }
.unity-toggle__checkmark { width: 44px; height: 44px; background-color: rgba(0,0,0,0.5); border-color: var(--gold); border-width: 2px; border-radius: 6px; }
.unity-label { color: var(--text); }
